# Copy to `deploy/.env` and adjust. Never commit the real file.

# Host port the signaling server is published on.
SIGNALING_PORT=8080

# Shared secret for TURN credentials. MUST match coturn's static-auth-secret.
# Generate with: openssl rand -hex 32
TURN_SECRET=change-me-to-a-long-random-string

# Lifetime of an issued TURN credential, in seconds.
TURN_TTL=3600

# Identifier embedded in issued TURN usernames.
TURN_USER=sharescreen

# TURN realm advertised to clients.
TURN_REALM=turn.example.com

# Host ports for coturn. Each TURN relay allocation takes one UDP port, so the
# range is relay capacity. Keep it small when publishing through Docker: a wide
# range (e.g. 49152-65535) creates one rule per port and stalls `compose up`.
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_MIN_PORT=49152
TURN_MAX_PORT=49251

# Log level for the signaling server.
RUST_LOG=info

# Only used by the optional `sfu` profile.
LIVEKIT_KEY=devkey: secret
SFU_PORT=7880
SFU_UDP_PORT=7881
